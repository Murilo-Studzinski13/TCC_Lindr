# Banco
LINDR_DB_HOST=127.0.0.1
LINDR_DB_NAME=lindr
LINDR_DB_USER=root
LINDR_DB_PASS=

# SMTP - exemplo Gmail
LINDR_SMTP_HOST=smtp.gmail.com
LINDR_SMTP_PORT=587
LINDR_SMTP_ENCRYPTION=tls
LINDR_SMTP_USER=seuemail@gmail.com
LINDR_SMTP_PASS=sua_senha_de_app
LINDR_MAIL_FROM=seuemail@gmail.com
LINDR_MAIL_NAME=Lindr

# URL pública do site (usada nos links de redefinição de senha). Ex.: https://lindr.exemplo.com.br
LINDR_APP_URL=http://localhost/lindrwork

# Chave que protege os segredos do 2FA no banco (opcional).
# Se vazia, o sistema cria storage/app.key sozinho. Gere uma com:  php -r "echo bin2hex(random_bytes(32));"
LINDR_APP_KEY=

# Verificação em duas etapas por e-mail (código em aparelho novo; padrão: ligada).
# Use 0 apenas em testes locais para desligar.
LINDR_2FA_OBRIGATORIO=1

# Confere se o domínio do e-mail existe no cadastro (padrão: ligado). Use 0 só se o servidor estiver sem DNS.
LINDR_VERIFICAR_DNS=1
